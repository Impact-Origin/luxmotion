# Convex deployment – from Dashboard or set automatically by `npx convex dev`
# Format: dev:<deployment-name> or prod:<deployment-name>
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Convex deployment URL (or your custom domain, e.g. https://convex.easytransferportugal.com)
CONVEX_URL=https://your-deployment-name.convex.cloud

# --- Rest: copy from Convex Dashboard → Settings → Environment Variables ---
