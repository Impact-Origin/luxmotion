# ===========================================
# WEB APP (apps/web) – copy to .env or .env.local
# ===========================================

# --- Required ---
# Convex: use your deployment URL or custom domain (e.g. https://xxx.convex.cloud or https://convex.easytransferportugal.com)
NEXT_PUBLIC_CONVEX_URL=

# Clerk: from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google Maps: from Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Optional ---
# Site URL for SEO / sitemap (e.g. https://easytransferportugal.com)
NEXT_PUBLIC_SITE_URL=
# or
NEXT_PUBLIC_APP_URL=

# Backend API base URL (if you use a separate API)
NEXT_PUBLIC_BACKEND_API_BASE_URL=

# Mock data (development only)
# NEXT_PUBLIC_USE_MOCK_TOURS=true
# NEXT_PUBLIC_USE_MOCK_BLOGS=true
# NEXT_PUBLIC_USE_MOCK_EVENTS=true
